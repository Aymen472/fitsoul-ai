# Application
APP_NAME=FitSoul AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API (Phase 2)
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Langfuse AI Observability (Optional — Phase 2)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# USDA FoodData Central API (Phase 1.4 — fallback nutrition lookup)
USDA_API_KEY=DEMO_KEY

# Supabase (Phase 1.5+)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Meta WhatsApp Cloud API (Phase 4 — notifications only)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
PWA_BASE_URL=http://localhost:3000

# Frontend Next.js PWA (Phase 3 — put in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
